{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitburner-discord-bot-endpoint",
  "main": "src/cf-worker/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.1,
      "persist": true,
    },
  },
}
